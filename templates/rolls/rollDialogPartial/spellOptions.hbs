<li class="SR-LigneEnTete SR-PaddingTop10 grid>
    <div class="col-12">{{localize 'SR5.SpellOptions'}}</div>
</li>

<!--FORCE-->
{{> systems/sr5/templates/rolls/rollDialogPartial/force.hbs}}

<!-- BLOOD MAGIC (Street Grimoire p. 90, Forbidden Arcana p. 122-130): the points at hand, those the caster draws from his
own wounds (martyr), and what they are spent on -->
{{#if dialogSwitch.bloodMagic}}
<li class="SR-LigneEnTete SR-PaddingTop10 grid SR-TextUppercase">
    <div class="col-10">{{localize 'SR5.BloodMagicPoints'}}</div>
    <div class="col-2 SR-TextRight">{{localize 'SR5.Value'}}</div>
</li>
<li class="grid">
    <div class="col-11" data-tooltip="{{localize 'SR5.BloodMagicLeft_D'}}">{{localize 'SR5.BloodMagicLeft'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input disabled type="number" name="bloodLeft" value="{{magic.bloodMagic.total}}" data-dtype="Number" placeholder="0" />
    </div>
</li>
<li class="grid">
    <div class="col-11" data-tooltip="{{localize 'SR5.BloodMartyrBoxes_D'}}">{{localize 'SR5.BloodMartyrBoxes'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input type="number" class="SR-ModInput" name="bloodMartyrBoxes" min="0" value="0" data-dtype="Number" placeholder="0" />
    </div>
</li>
<li class="grid">
    <div class="col-11">{{localize 'SR5.BloodSpendForce'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input type="number" class="SR-ModInput" name="bloodForce" min="0" value="0" data-dtype="Number" placeholder="0" />
    </div>
</li>
<li class="grid">
    <div class="col-11">{{localize 'SR5.BloodSpendDrainMagic'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input type="number" class="SR-ModInput" name="bloodDrainMagic" min="0" value="0" data-dtype="Number" placeholder="0" />
    </div>
</li>
<li class="grid">
    <div class="col-11">{{localize 'SR5.BloodSpendDrain'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input type="number" class="SR-ModInput" name="bloodDrain" min="0" value="0" data-dtype="Number" placeholder="0" />
    </div>
</li>
{{/if}}

<!-- INCREASE / DECREASE NOISE (Street Grimoire p. 113): the grid affected sets the threshold (2 / 4 / 6) -->
{{#if dialogSwitch.noiseGrid}}
<li class="grid">
    <div class="col-4">{{localize 'SR5.NoiseSpellGrid'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-7">
        <select class="SR-ModSelect SR-ModSelectFilled" data-target="noiseGridThreshold" data-modifier="noiseGrid">
            {{selectOptions magic.noiseSpell.grids selected=magic.noiseSpell.grid localize=true sort=false}}
        </select>
    </div>
    <div class="col-1 SR-TextCenter" data-tooltip="{{localize 'SR5.Threshold'}}">
        <input disabled type="number" name="noiseGridThreshold" value="{{threshold.value}}" placeholder="0" data-dtype="Number" />
    </div>
</li>
{{/if}}

<!--RECKLESS SPELLCASTING-->
{{#unless magic.structured}}
{{> systems/sr5/templates/rolls/rollDialogPartial/recklessSpellcasting.hbs}}
{{/unless}}

<!-- RAPID-FIRE CASTER (Forbidden Arcana p. 38): reckless casting without the Drain increase, once per day per level -->
{{#if dialogSwitch.rapidFireCaster}}
<li class="grid">
    {{#if magic.rapidFireCaster.remaining}}
    <div class="col-10">{{localize 'SR5.MagicMasteryRapidFireCaster'}} ({{localize 'SR5.RapidFireCasterRemaining' remaining=magic.rapidFireCaster.remaining level=magic.rapidFireCaster.level}}){{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextRight">
        <input type="checkbox" class="SR-ModCheckbox" data-modifier="rapidFireCaster">
    </div>
    {{else}}
    <div class="col-10" data-tooltip="{{localize 'SR5.RapidFireCasterRest_D'}}">{{localize 'SR5.MagicMasteryRapidFireCaster'}} ({{localize 'SR5.RapidFireCasterRest'}}){{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextRight">
        <input type="checkbox" class="SR-ModCheckbox" data-modifier="rapidFireCasterRest">
    </div>
    {{/if}}
</li>
{{/if}}

<!-- MAGE HUNTER (Forbidden Arcana p. 34): +1 Drain per level for -2 per level to the counterspelling against the spell -->
{{#if dialogSwitch.mageHunter}}
<li class="grid">
    <div class="col-10">{{localize 'SR5.MagicMasteryMageHunter'}} ({{localize 'SR5.MageHunterTrade' level=magic.mageHunter.level}}){{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextRight">
        <input type="checkbox" class="SR-ModCheckbox" data-target="dicePoolModMageHunter" data-modifier="mageHunter">
    </div>
</li>
{{/if}}

<!-- SPIRIT AID -->
{{#if dialogSwitch.spiritAid}}
    {{> systems/sr5/templates/rolls/rollDialogPartial/spiritAidCommand.hbs}}
{{/if}}

<!--REAGENTS-->
{{#if dialogSwitch.reagents}}
      {{> systems/sr5/templates/rolls/rollDialogPartial/reagents.hbs}}
{{/if}}

<!-- SPELL SHAPING METAMAGIC -->
{{#if dialogSwitch.spellShaping}}
    {{> systems/sr5/templates/rolls/rollDialogPartial/spellShaping.hbs}}
{{/if}}