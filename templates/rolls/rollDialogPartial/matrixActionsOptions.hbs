<li class="SR-PaddingTop5 grid">
    <div class="col-11 SR-DialogOption">{{localize 'SR5.MatrixActionsOptions'}}</div>
</li>

<!-- NOISE -->
{{> systems/sr5/templates/rolls/rollDialogPartial/matrixNoiseModifier.hbs}}

<!-- GRID -->
{{#if dialogSwitch.publicGrid}}
    {{> systems/sr5/templates/rolls/rollDialogPartial/matrixGrid.hbs}}
{{/if}}
{{> systems/sr5/templates/rolls/rollDialogPartial/matrixTargetGrid.hbs}}


<!-- NORMAL ACTION OR INTERRUPTION: I Am the Firewall (Kill Code p. 43), or a Watchdog mark (Kill Code p. 45) -->
{{#if dialogSwitch.matrixActionType}}
<li class="grid">
    <div class="col-7">{{localize 'SR5.MatrixActionTypeChoice'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-5 SR-TextRight">
        <select class="SR-ModSelect" data-target="matrixActionType" data-modifier="matrixActionType">
            <option value="{{combat.matrixActionTypeDefault}}" {{#unless (eq combat.matrixActionType "interruption")}}selected{{/unless}}>{{combat.matrixActionTypeLabel}}</option>
            <option value="interruption" {{#if (eq combat.matrixActionType "interruption")}}selected{{/if}}>{{localize 'SR5.ActionTypeInterruption'}} (-{{combat.interruptionInitiativeCost}} {{localize 'SR5.Initiative'}})</option>
        </select>
    </div>
</li>
{{/if}}

<!-- AI: EMULATE (Data Trails p. 159) -->
{{#if dialogSwitch.emulate}}
<li class="grid">
    <div class="col-8">{{localize 'SR5.MatrixActionEmulateRating' max=matrix.emulateMax}}{{localize 'SR5.Colons'}}</div>
    <div class="col-3 SR-TextRight">
        <input type="number" class="SR-ModInput" name="emulateRating" data-modifier="emulate" value="0" min="{{#if matrix.emulateRequired}}1{{else}}0{{/if}}" max="{{matrix.emulateMax}}" data-dtype="Number" />
    </div>
    <div class="col-1 SR-TextCenter">
        <input disabled type="number" name="dicePoolModEmulate" value="0" placeholder="0" data-dtype="Number" />
    </div>
</li>
<!-- Data Trails p. 157: emulating for a legal action raises no Overwatch Score -->
<li class="grid">
    <div class="col-11">{{localize 'SR5.MatrixActionEmulateLegal'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-1 SR-TextCenter">
        <input type="checkbox" name="emulateLegal" />
    </div>
</li>
{{/if}}

<!-- AI: REDEFINE OWNERSHIP THRESHOLD (Data Trails p. 160) -->
{{#if dialogSwitch.redefineOwnership}}
<li class="grid">
    <div class="col-9">{{localize 'SR5.MatrixActionRedefineOwnershipThreshold'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-3 SR-TextRight">
        <input type="number" class="SR-ManageThreshold" data-target="redefineOwnershipThreshold" name="redefineOwnershipThreshold" value="0" min="0" data-dtype="Number" />
    </div>
</li>
{{/if}}

<!-- MARKS WANTED -->
{{#if (or (eq test.typeSub "hackOnTheFly") (eq test.typeSub "bruteForce"))}}
    {{> systems/sr5/templates/rolls/rollDialogPartial/markModifier.hbs}}
{{/if}}