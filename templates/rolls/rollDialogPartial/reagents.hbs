<li class="grid">
    <div class="col-9">{{localize 'SR5.Reagents'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-2 SR-TextRight">
        <div class="grid">
            <span class="col-auto">
                <input type="checkbox" class="SR-ModCheckbox" data-target="reagentsSpent" data-modifier="reagents">
            </span>
            <span class="col-auto" id="reagentsModControl" style="display: none;">
                <a class="SR-ModControl" data-target="reagentsSpent" data-type="minus" data-modifier="reagentsSpent"><em class="fas fa-minus-circle"></em></a>
                <a class="SR-ModControl" data-target="reagentsSpent" data-type="plus" data-modifier="reagentsSpent"><em class="fas fa-plus-circle"></em></a>
            </span>
        </div>
    </div>
    <div class="col-1 SR-TextCenter" id="useReagents" style="display: none;">
        <input type="number" class="SR-ModInput" name="reagentsSpent" data-modifier="reagentsSpent" value="{{reagentsSpent}}" data-dtype="Number" placeholder="0" />
    </div>
</li>
{{#if magic.reagentChoices.hasTiers}}
<li class="grid SR-ReagentOptions" style="display: none;">
    <div class="col-8">{{localize 'SR5.ReagentTier'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-4 SR-TextRight">
        <select name="reagentTier" class="SR-ReagentTier">
            {{#each magic.reagentChoices.tiers}}
            <option value="{{this.key}}" {{#if (eq this.key ../magic.reagentTier)}}selected{{/if}}>{{localize this.label}} ({{this.stock}})</option>
            {{/each}}
        </select>
    </div>
</li>
{{/if}}
<li class="grid SR-ReagentOptions" style="display: none;" data-tooltip="{{localize 'SR5.ReagentForeignHint'}}">
    <div class="col-11">{{localize 'SR5.ReagentForeign'}}</div>
    <div class="col-1 SR-TextCenter">
        <input type="checkbox" name="reagentForeign" class="SR-ReagentForeign" {{#if magic.reagentForeign}}checked{{/if}}>
    </div>
</li>
