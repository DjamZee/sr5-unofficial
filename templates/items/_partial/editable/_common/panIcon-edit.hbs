<!-- The icon of the item in the crown of its PAN (couronne du PAN, lot 10): it takes the place of the generic icon of its category, and follows the item when it is copied -->
<ul class="SR-PaddingTop10">
	<li class="grid">
		<div class="col-4" data-tooltip="{{localize 'SR5.PanIconHint'}}">{{localize 'SR5.PanIcon'}}{{localize 'SR5.Colons'}}</div>
		<div class="col-8"><file-picker name="flags.sr5.panIcon" type="image" value="{{item.flags.sr5.panIcon}}" placeholder="{{localize 'SR5.PanIconGeneric'}}"></file-picker></div>
	</li>
</ul>
