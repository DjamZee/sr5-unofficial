<!-- Commcode of a contact played without a sheet (SR5 p. 241, API pour CONTACTS): the gamemaster answers on it -->
<li class="grid">
    <div class="col-4">{{localize 'SR5.Commcode'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-8"><input type="text" data-dtype="String" name="system.commcode" value="{{system.commcode}}" placeholder="{{localize 'SR5.ContactCommcodePlaceholder'}}" data-tooltip="{{localize 'SR5.ContactCommcodeHint'}}"/></div>
</li>
