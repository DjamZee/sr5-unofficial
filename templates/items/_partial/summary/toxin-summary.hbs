<li class="grid">
    <p>
        <span class="col-auto">{{localize 'SR5.ToxinVector'}}{{localize 'SR5.Colons'}}</span>
        <span class="col-auto SR-GreyColor">{{#each system.vector}}{{#if this}}{{findTranslation 'propagationVectors' @key}} {{/if}}{{/each}}</span>
    </p>
</li>
<li class="grid">
    <p>
        <span class="col-auto">{{localize 'SR5.ToxinSpeed'}}{{localize 'SR5.Colons'}}</span>
        <span class="col-auto SR-GreyColor">{{#if system.speed}}{{system.speed}} {{ifmto system.speed 'SR5.CombatTurns' 'SR5.CombatTurn'}}{{else}}{{localize 'SR5.ToxinSpeedImmediate'}}{{/if}}</span>
    </p>
</li>
<li class="grid">
    <p>
        <span class="col-auto">{{localize 'SR5.ToxinPower'}}{{localize 'SR5.Colons'}}</span>
        <span class="col-auto SR-GreyColor">{{#if system.powerFromMagic}}{{localize 'SR5.Magic'}}{{else}}{{system.power}}{{/if}}</span>
    </p>
</li>
<li class="grid">
    <p>
        <span class="col-auto">{{localize 'SR5.ToxinPenetration'}}{{localize 'SR5.Colons'}}</span>
        <span class="col-auto SR-GreyColor">{{system.penetration}}</span>
    </p>
</li>
<li class="grid">
    <p>
        <span class="col-auto">{{localize 'SR5.ToxinEffect'}}{{localize 'SR5.Colons'}}</span>
        <span class="col-auto SR-GreyColor">{{#if system.damageType}}{{findTranslation 'damageTypes' system.damageType}} {{/if}}{{#each system.effect}}{{#if this}}{{findTranslation 'toxinEffects' @key}} {{/if}}{{/each}}{{system.special}}</span>
    </p>
</li>
