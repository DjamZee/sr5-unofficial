<!-- General Stat -->
<ul>
	<!-- General information title -->
	{{> systems/sr5/templates/items/_partial/title/generalInformation.hbs}}
	<!-- Weapon Category -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/category-edit.hbs}}
	<!-- Weapon Type -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/type-edit.hbs}}
	<!-- Weapon Skill -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/skill-edit.hbs}}
	<!-- Device rating -->
	{{> systems/sr5/templates/items/_partial/editable/_common/deviceRating-edit.hbs}}
	{{#ife system.type "bow"}}
	<!-- Item rating -->
	{{> systems/sr5/templates/items/_partial/editable/_common/rating-edit.hbs}}
	{{/ife}}
	<!-- Concealability Modifier -->
	{{> systems/sr5/templates/items/_partial/editable/_common/concealabilityModifier-edit.hbs}}
	<!-- Required hands -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/requiredHands-edit.hbs}}
	<!-- Not made for its holder's size, SR5 p. 423 -->
	{{> systems/sr5/templates/items/_partial/editable/_common/notSizeAdapted-edit.hbs}}
	{{#ife system.category "weaponAccessory"}}
	<!-- Special effect the system reads (a homemade flashlight, a smartgun system...) -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/specialEffect-edit.hbs}}
	<!-- Price as a multiple of the carrying weapon's (HT p. 180-181, SR5 p. 435) -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/weaponPriceMultiplier-edit.hbs}}
	{{/ife}}
</ul>

<!-- Vision enhancements of a weapon accessory (SR5 p. 434) -->
{{> systems/sr5/templates/items/_partial/editable/weapon/visionEnhancements-edit.hbs}}

<!-- Damage -->
<ul class="SR-PaddingTop10">
	<!-- Damage title -->
	{{> systems/sr5/templates/items/_partial/title/damage.hbs}}
	<!-- Damage value, type & special -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/damage-edit.hbs}}
	<!-- Toxin block -->
	{{#ife system.damageElement "toxin"}}
		{{> systems/sr5/templates/items/_partial/editable/weapon/toxin-edit.hbs}}
	{{else}}
		<!-- Dropping a toxin here makes it a toxin weapon -->
		<li class="grid sr5-toxin-drop SR-LightGreyColor">
			<div class="col-5"></div>
			<div class="col-7"><em class="fas fa-skull-crossbones"></em> {{localize 'SR5.ToxinDropHint'}}</div>
		</li>
	{{/ife}}

	{{#if (or (eq system.category "rangedWeapon") (eq system.category "meleeWeapon"))}}
		<!-- Accuracy -->
		{{> systems/sr5/templates/items/_partial/editable/weapon/accuracy-edit.hbs}}
	{{/if}}

	<!-- Armor Penetration -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/armorPenetration-edit.hbs}}

	{{#ife system.category "rangedWeapon"}}
		<!-- Recoil Compensation -->
		{{> systems/sr5/templates/items/_partial/editable/weapon/recoilCompensation-edit.hbs}}

		{{#if (or (eq system.type "grenadeLauncher") (eq system.type "missileLauncher"))}}
		<!-- Blast & Drop off -->
			{{> systems/sr5/templates/items/_partial/editable/weapon/blast-edit.hbs}}
		{{/if}}
	{{/ife}}

	{{#ife system.category "grenade"}}
		<!-- Blast & Drop off -->
		{{> systems/sr5/templates/items/_partial/editable/weapon/blast-edit.hbs}}

		<!-- Aerodynamic-->
		{{> systems/sr5/templates/items/_partial/editable/weapon/aerodynamic-edit.hbs}}
	{{/ife}}
</ul>

<!-- ATTACK RANGES -->
<ul class="SR-PaddingTop10">
	<li class="SR-EnTete">
		<p class="SR-TextUppercase">{{localize 'SR5.WeaponRange'}}</p>
	</li>

	<!-- MELEE -->
	{{#ife system.category "meleeWeapon"}}
		<!-- Reach-->
		{{> systems/sr5/templates/items/_partial/editable/weapon/reach-edit.hbs}}
	{{/ife}}

	<!-- RANGED WEAPON -->
	{{#if (or (eq system.category "rangedWeapon") (eq system.category "grenade") )}}
		{{> systems/sr5/templates/items/_partial/editable/weapon/range-edit.hbs}}
	{{/if}}
</ul>

{{#ife system.category "rangedWeapon"}}
<!-- FIRING MODES -->
<ul class="SR-PaddingTop10">
	{{> systems/sr5/templates/items/_partial/editable/weapon/firingModes-edit.hbs}}
</ul>

{{#ife system.type "shotgun"}}
<!-- CHOKE SETTINGS -->
<ul class="SR-PaddingTop10">
	{{> systems/sr5/templates/items/_partial/editable/weapon/chokeSettings-edit.hbs}}
</ul>

{{/ife}}

<!-- AMMUNITION -->
<ul class="SR-PaddingTop10">
	<li class="SR-EnTete">
		<p class="SR-TextUppercase">{{localize 'SR5.Ammunition'}}</p>
	</li>

	<!-- Ammunition max -->
	{{> systems/sr5/templates/items/_partial/editable/weapon/ammunitionMax-edit.hbs}}

	{{#ifne system.type "throwing"}}
		<!-- Ammunition type -->
		{{> systems/sr5/templates/items/_partial/editable/weapon/ammunitionType-edit.hbs}}
		{{#ife system.type "bow"}}
		<!-- Ammunition type -->
		{{> systems/sr5/templates/items/_partial/editable/weapon/ammunitionRating-edit.hbs}}
		{{/ife}}
		<!-- Reloading method -->
		{{> systems/sr5/templates/items/_partial/editable/weapon/reloadingMethod-edit.hbs}}
	{{/ifne}}
</ul>

<!-- ACCESSORIES -->
{{> systems/sr5/templates/items/_partial/editable/weapon/accessories-edit.hbs}}

{{/ife}}

<!-- PRICE AND AVAILABILITY -->
<ul class="SR-PaddingTop10">
	{{> systems/sr5/templates/items/_partial/editable/_common/price-edit.hbs}}
</ul>
{{> systems/sr5/templates/items/_partial/editable/_common/panIcon-edit.hbs}}
