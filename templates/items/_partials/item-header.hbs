<div class="SR-Header">
	<img class="SRImgItem" src="{{item.img}}" data-tooltip="{{localize 'SR5.UI_ChangePicture'}}" data-edit="img" data-action="editImage" />
	{{#if hasTokenImage}}
	<img class="SRImgItem SRImgToken" src="{{#if system.tokenImg}}{{system.tokenImg}}{{else}}{{item.img}}{{/if}}" data-tooltip="{{localize 'SR5.UI_ChangeTokenPicture'}}" data-edit="system.tokenImg" data-action="editImage" />
	{{/if}}
	<h1 class="SRItemTitre"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'SR5.Name'}}" /></h1>
	{{> systems/sr5/templates/items/_partial/header/device-mode.hbs}}
	<nav class="sr-icon-nav tabs">
		{{#each layout.panels}}
			{{#unless @first}}
				<div class="sr-nav-separator"></div>
			{{/unless}}
			{{#each this.tabs}}
				<a data-action="tab" data-group="{{this.group}}" data-tab="{{this.id}}" class="{{this.cssClass}}" {{#if this.tooltip}}data-tooltip="{{this.tooltip}}"{{/if}}>
					{{#if this.faIcon}}<em class="fas {{this.faIcon}} sr-tab-fa"></em>{{else}}{{> (lookup this "icon") }}{{/if}}
				</a>
			{{/each}}
		{{/each}}
	</nav>
</div>