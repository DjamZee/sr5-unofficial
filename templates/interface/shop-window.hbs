<div class="sr-shop">

  {{!-- Left: the shelves --}}
  <nav class="sr-shop-shelves">
    {{#if (gt sources.length 1)}}
    <h4>{{localize 'SR5.ShopWhere'}}</h4>
    {{!-- Shelves or vendors first, then which vendor (relecture djamz.13, lot R6) --}}
    {{#if (and sourceWorld vendorSources.length)}}
    <div class="sr-shop-where" role="tablist">
      <a class="sr-shop-where-tab {{#unless onVendor}}active{{/unless}}" data-action="setWhere" data-where="world" role="tab"><i class="fas fa-fw fa-store"></i> {{localize 'SR5.ShopWhereShelves'}}</a>
      <a class="sr-shop-where-tab {{#if onVendor}}active{{/if}}" data-action="setWhere" data-where="vendor" role="tab"><i class="fas fa-fw fa-user-tie"></i> {{localize 'SR5.ShopWhereVendors'}} <span class="count">{{vendorSources.length}}</span></a>
    </div>
    {{/if}}
    {{#if onVendor}}
    <select class="sr-shop-source" data-shop-source aria-label="{{localize 'SR5.ShopWhereVendors'}}">
      {{#each vendorSources}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
    </select>
    {{/if}}
    {{/if}}
    <h4>{{localize 'SR5.ShopShelves'}}</h4>
    <a class="sr-shop-shelf {{#if allActive}}active{{/if}}" data-action="setShelf" data-shelf="">
      <span><i class="fas fa-fw fa-store"></i> {{localize 'SR5.ShopShelfAll'}}</span><span class="count">{{allCount}}</span>
    </a>
    {{#each shelves}}
    <a class="sr-shop-shelf {{#if this.active}}active{{/if}}" data-action="setShelf" data-shelf="{{this.key}}">
      <span><i class="fas fa-fw {{this.icon}}"></i> {{this.label}}</span><span class="count">{{this.count}}</span>
    </a>
    {{#each this.subs}}
    <a class="sr-shop-shelf sub {{#if this.active}}active{{/if}}" data-action="setShelf" data-shelf="{{../key}}" data-sub="{{this.key}}">
      <span>{{this.label}}</span><span class="count">{{this.count}}</span>
    </a>
    {{/each}}
    {{/each}}
  </nav>

  {{!-- Middle: filters and rows --}}
  <section class="sr-shop-main">
    {{#if vendor}}
    {{!-- The vendor's sign: banner 3:1 and portrait (lot C; the templates of part 2 bring the banners) --}}
    <header class="sr-shop-vendor {{#if vendor.banner}}has-banner{{/if}}">
      {{#if vendor.banner}}<img class="sr-shop-banner" src="{{vendor.banner}}" alt="">{{/if}}
      <div class="sr-shop-vendor-id">
        {{#if vendor.portrait}}<img class="sr-shop-portrait" src="{{vendor.portrait}}" alt="">{{/if}}
        <div>
          <b>{{vendor.label}}</b>
          <small>{{vendor.name}}{{#if vendor.marginLabel}} · {{localize 'SR5.ShopVendorMarginShort' value=vendor.marginLabel}}{{/if}}</small>
          {{#if vendor.closed}}<small class="sr-shop-blocked"><i class="fas fa-door-closed"></i> {{localize 'SR5.ShopVendorClosedHint'}}</small>{{/if}}
          {{#if vendorRefusal}}<small class="sr-shop-blocked sr-shop-refusal"><i class="fas fa-hand"></i> {{vendorRefusal}}</small>{{/if}}
        </div>
        {{#if vendor.infoBroker}}
        {{!-- Lot 37a: data for sale (Cutting Aces p. 148-149) --}}
        <button type="button" class="sr-shop-infobroker" data-action="openInfoBroker"><i class="fas fa-user-secret"></i> {{localize 'SR5.INFOBROKER_Open'}}</button>
        {{/if}}
      </div>
    </header>
    {{/if}}
    <header class="sr-shop-filters">
      <label class="sr-shop-search">
        <i class="fas fa-search"></i>
        <input type="text" data-shop-search value="{{search}}" placeholder="{{localize 'SR5.ShopSearch'}}" autocomplete="off">
      </label>
      <label class="sr-shop-max">{{localize 'SR5.ShopMaxPrice'}}
        <input type="number" min="0" data-shop-max="price" value="{{maxPrice}}" placeholder="—"> &yen;
      </label>
      <label class="sr-shop-max">{{localize 'SR5.ShopMaxAvailability'}}
        <input type="number" min="0" data-shop-max="availability" value="{{maxAvailability}}" placeholder="—">
      </label>
      <span class="sr-shop-chips">
        {{#each legality}}
        <button type="button" class="sr-shop-chip legality-{{#if this.key}}{{this.key}}{{else}}legal{{/if}} {{#if this.active}}active{{/if}}"
                data-action="toggleLegality" data-legality="{{this.key}}" aria-pressed="{{this.active}}">{{this.label}}</button>
        {{/each}}
      </span>
      <label class="sr-shop-chip {{#if affordable}}active{{/if}}">
        <input type="checkbox" data-shop-affordable {{#if affordable}}checked{{/if}}> {{localize 'SR5.ShopAffordableOnly'}}
      </label>
      <span class="sr-shop-filter-actions">
        <button type="button" data-action="clearFilters" data-tooltip="{{localize 'SR5.Clear'}}" aria-label="{{localize 'SR5.Clear'}}"><i class="fas fa-eraser"></i></button>
        <button type="button" data-action="refresh" data-tooltip="{{localize 'SR5.ShopRefresh'}}" aria-label="{{localize 'SR5.ShopRefresh'}}"><i class="fas fa-sync"></i></button>
      </span>
    </header>

    <div class="sr-shop-head">
      <span></span>
      <span>{{localize 'SR5.Name'}}</span>
      <span>{{localize 'SR5.ShopAvailability'}}</span>
      <span>{{localize 'SR5.ShopDelay'}}</span>
      <span>{{localize 'SR5.ShopGrade'}}</span>
      <span class="right">{{localize 'SR5.ShopPrice'}}</span>
      <span></span>
    </div>

    <ol class="sr-shop-list">
      {{#each rows}}
      <li class="sr-shop-row {{#if this.dim}}dim{{/if}}" data-uuid="{{this.uuid}}" data-name="{{this.name}}" draggable="true" data-action="viewItem">
        <img src="{{this.img}}" alt="" loading="lazy" decoding="async">
        <div class="sr-shop-name">
          <b {{#if this.nameVO}}data-tooltip="{{localize 'SR5.ShopNameVO' name=this.nameVO}}"{{/if}}>{{this.name}}</b>
          {{#if this.stock}}<span class="sr-shop-tag stock">{{localize 'SR5.ShopVendorInStock' count=this.stock}}</span>{{/if}}
          {{#if this.onOrder}}<span class="sr-shop-tag on-order"><i class="fas fa-truck"></i> {{localize 'SR5.ShopVendorOnOrder'}}</span>{{/if}}
          {{#if this.notForSale}}<span class="sr-shop-tag"><i class="fas fa-store-slash"></i> {{localize 'SR5.ShopNotForSale'}}</span>{{/if}}
          {{#if this.onVehicle}}<span class="sr-shop-tag" data-tooltip="{{localize 'SR5.ShopOnVehicleHint'}}"><i class="fas fa-car"></i> {{localize 'SR5.ShopOnVehicle'}}</span>{{/if}}
          {{#if this.onWeapon}}<span class="sr-shop-tag" data-tooltip="{{localize 'SR5.ShopOnWeaponHint'}}"><i class="fas fa-gun"></i> {{localize 'SR5.ShopOnWeapon'}}</span>{{/if}}
          <small>{{this.summary}}</small>
          {{#if this.blocked}}<small class="sr-shop-blocked">{{this.blockedLabel}}</small>{{/if}}
          {{#if this.overLimitLabel}}<small class="sr-shop-blocked"><i class="fas fa-triangle-exclamation"></i> {{this.overLimitLabel}}</small>{{/if}}
        </div>
        <div class="sr-shop-availability">
          <b class="legality-{{this.legality}}">{{this.availability}}</b>
          {{#if this.common}}
          <small>{{localize 'SR5.ShopCommonGoods'}}</small>
          {{else if this.odds}}
          <small data-tooltip="{{localize 'SR5.ShopOddsHint'}}"><span class="sr-shop-dot odds-{{this.odds}}"></span>{{this.oddsLabel}}</small>
          {{/if}}
        </div>
        <div class="sr-shop-delay">{{this.delay}}</div>
        <div class="sr-shop-grade sr-shop-row-buy">
          {{#if this.grades.length}}
          <select data-shop-grade aria-label="{{localize 'SR5.AugmentationGrade'}}">
            {{#each this.grades}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
          {{else}}—{{/if}}
        </div>
        <div class="sr-shop-price {{#if this.tooExpensive}}too-expensive{{/if}}" {{#if this.priceNotes}}title="{{this.priceNotes}}"{{/if}}>{{#if this.bookPrice}}<s class="sr-shop-price-book" aria-label="{{localize 'SR5.ShopBookPrice'}}">{{this.bookPrice}}</s> {{/if}}{{this.price}}</div>
        <div class="sr-shop-row-buy">
          {{#if this.canBuy}}
          <input type="number" min="1" value="1" data-row-qty aria-label="{{localize 'SR5.Quantity'}}">
          {{#unless this.common}}{{#if this.tested}}
          <button type="button" data-action="testAvailability" data-tooltip="{{localize 'SR5.ShopTestAvailability'}}" aria-label="{{localize 'SR5.ShopTestAvailability'}}"><i class="fas fa-dice"></i></button>
          {{/if}}{{/unless}}
          <button type="button" class="accent" data-action="addToCart" data-tooltip="{{localize 'SR5.ShopAddToCart'}}" aria-label="{{localize 'SR5.ShopAddToCart'}}"><i class="fas fa-cart-plus"></i></button>
          {{/if}}
        </div>
      </li>
      {{else}}
      {{#if marketClosed}}
      <li class="sr-shop-empty"><i class="fas fa-store-slash"></i> {{localize 'SR5.ShopMarketClosed'}}</li>
      {{else if loading}}
      <li class="sr-shop-empty"><i class="fas fa-spinner fa-spin"></i> <span data-shop-progress>{{loadingLabel}}</span></li>
      {{else}}
      <li class="sr-shop-empty">{{localize 'SR5.NoResults'}}</li>
      {{/if}}
      {{/each}}
    </ol>

    <footer class="sr-shop-footer">
      <span>{{countLabel}}</span>
      {{#if hasMore}}
      <button type="button" data-action="loadMore">{{localize 'SR5.LoadMore'}} ({{shownCount}} / {{totalCount}})</button>
      {{/if}}
    </footer>
  </section>

  {{!-- Right: buyer, searcher, cart, till --}}
  <aside class="sr-shop-till">
    <h4>{{localize 'SR5.ShopBuyer'}}</h4>
    <div class="sr-shop-box">
      <select data-shop-buyer>
        {{#unless buyer}}<option value="" selected>{{localize 'SR5.ShopChooseBuyer'}}</option>{{/unless}}
        {{#each buyers}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
      </select>
      {{#if buyer}}
      {{#if payChoices}}
      <div class="sr-shop-inline">
        <span>{{localize 'SR5.ShopVendorPayWith'}}</span>
        <select data-shop-pay>
          {{#each payChoices}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
      </div>
      {{/if}}
      <div class="sr-shop-balance {{#if free}}muted{{/if}}">{{balanceLabel}} <b>{{buyer.balance}}</b></div>
      {{/if}}
    </div>

    {{#if buyer}}
    <h4>{{localize 'SR5.ShopSearchedBy'}}</h4>
    <div class="sr-shop-box">
      {{#if vendor}}
      <p class="muted">{{localize 'SR5.ShopVendorSearches' name=vendor.name}}</p>
      {{else}}
      <select data-shop-contact>
        <option value="">{{localize 'SR5.ShopMyself'}}</option>
        {{#each contacts}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}} ({{this.connection}})</option>{{/each}}
      </select>
      {{/if}}
      <div class="sr-shop-inline">
        <span>{{localize 'SR5.ShopSurcharge'}}</span>
        <select data-shop-surcharge>
          {{#each surchargeChoices}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
        </select>
      </div>
      <div class="sr-shop-inline">
        {{!-- The gamemaster rolls every test: a pool typed by a player would never reach the dice --}}
        {{#if isGM}}
        <input type="number" min="0" data-shop-override="pool" value="{{overridePool}}" placeholder="{{localize 'SR5.ShopPoolShort'}}" data-tooltip="{{localize 'SR5.ShopOverridePoolHint'}}">
        <input type="number" min="0" data-shop-override="limit" value="{{overrideLimit}}" placeholder="{{localize 'SR5.ShopLimitShort'}}" data-tooltip="{{localize 'SR5.ShopOverrideLimitHint'}}">
        {{/if}}
        <span class="muted">{{localize 'SR5.ShopPoolNow' pool=pool}}</span>
      </div>
    </div>
    {{/if}}

    <h4>{{localize 'SR5.ShopCart'}} ({{cartCount}})</h4>
    <div class="sr-shop-box sr-shop-cart">
      {{#each cart}}
      <div class="sr-shop-cart-line {{#if this.blocked}}blocked{{/if}}" data-cart-key="{{this.key}}" {{#if this.blocked}}data-tooltip="{{this.blockedLabel}}"{{else if this.overLimitLabel}}data-tooltip="{{this.overLimitLabel}}"{{/if}}>
        <span class="name">{{#if this.overLimitLabel}}<i class="fas fa-triangle-exclamation"></i> {{/if}}{{this.name}}</span>
        <input type="number" min="1" value="{{this.quantity}}" data-cart-qty aria-label="{{localize 'SR5.Quantity'}}">
        <span class="price">{{this.totalLabel}}</span>
        <button type="button" data-action="removeFromCart" data-tooltip="{{localize 'SR5.ShopRemoveFromCart'}}" aria-label="{{localize 'SR5.ShopRemoveFromCart'}}"><i class="fas fa-xmark"></i></button>
      </div>
      {{else}}
      <p class="muted">{{localize 'SR5.ShopCartEmpty'}}</p>
      {{/each}}
      {{#if cartCount}}
      <div class="sr-shop-cart-total {{#unless cartAffordable}}too-expensive{{/unless}}">
        <b>{{localize 'SR5.ShopTotal'}}</b><b>{{cartTotal}}</b>
      </div>
      {{#if cartBlocked}}<small class="sr-shop-blocked"><i class="fas fa-triangle-exclamation"></i> {{localize 'SR5.ShopCartBlocked'}}</small>{{/if}}
      {{#if vendorRefusal}}<small class="sr-shop-blocked"><i class="fas fa-hand"></i> {{vendorRefusal}}</small>{{/if}}
      <small class="muted">
        {{#if cartLeft}}{{localize 'SR5.ShopLeftAfter' value=cartLeft}}{{/if}}
        {{#if cartDelay}} · {{localize 'SR5.ShopLongestDelay' value=cartDelay}}{{/if}}
        {{#if cartEssence}} · {{localize 'SR5.ShopEssenceTotal' value=cartEssence}}{{/if}}
      </small>
      {{/if}}
    </div>

    <button type="button" data-action="testCartAvailability" {{#unless canCheckout}}disabled{{/unless}}>
      <i class="fas fa-dice"></i> {{localize 'SR5.ShopTestCart'}}
    </button>
    <button type="button" class="accent {{#unless cartAffordable}}too-expensive{{/unless}}" data-action="checkoutCart" {{#unless canCheckout}}disabled{{/unless}}>
      <i class="fas fa-receipt"></i>
      {{#if equipMode}}{{localize 'SR5.ShopEquipCheckout'}}{{else if creationMode}}{{localize 'SR5.ShopCheckoutFree'}}{{else}}{{localize 'SR5.ShopPay' price=cartTotal}}{{/if}}
    </button>
    {{#if buyer}}
    <button type="button" data-action="openSell"><i class="fas fa-hand-holding-dollar"></i> {{localize 'SR5.ShopSell'}}</button>
    {{/if}}

    {{#if isGM}}
    <h4>{{localize 'SR5.ShopGamemaster'}}</h4>
    <div class="sr-shop-box">
      <button type="button" data-action="newVendor"><i class="fas fa-store"></i> {{localize 'SR5.ShopVendorNew'}}</button>
      <label data-tooltip="{{localize 'SR5.ShopCreationModeHint'}}">
        <input type="checkbox" data-shop-creation {{#if creationMode}}checked{{/if}}> {{localize 'SR5.ShopCreationMode'}}
        {{#if creationLimits}}<span class="muted">({{#unless creationMode}}{{localize 'SR5.CreationActorBadge'}}, {{/unless}}{{creationLimitsLabel}})</span>{{/if}}
      </label>
      <label data-tooltip="{{localize 'SR5.ShopEquipModeHint'}}">
        <input type="checkbox" data-shop-equip {{#if equipMode}}checked{{/if}}> {{localize 'SR5.ShopEquipMode'}}
      </label>
    </div>
    {{else if creationMode}}
    <p class="muted" data-tooltip="{{localize 'SR5.ShopCreationModeHint'}}">{{localize 'SR5.ShopCreationMode'}}
      ({{creationLimitsLabel}})</p>
    {{else if creationLimits}}
    <p class="muted" data-tooltip="{{localize 'SR5.ShopCreationActorHint'}}">{{localize 'SR5.CreationActorBadge'}}
      ({{creationLimitsLabel}})</p>
    {{/if}}
  </aside>
</div>
