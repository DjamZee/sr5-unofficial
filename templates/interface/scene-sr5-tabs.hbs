<div>
<!-- SR5 Environmental Modifiers -->
<div class="tab" data-group="sheet" data-tab="environmentalMod">
    <div class="form-group">
        <p class="notes">{{localize 'SR5.SceneEnvironmentalMsg'}}</p>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.EnvironmentalModVisibility'}}</label>
        <select name="flags.sr5.environModVisibility">
            {{selectOptions sr5lists.environModVisibility selected=document.flags.sr5.environModVisibility localize=true}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.EnvironmentalModLight'}}</label>
        <select name="flags.sr5.environModLight">
            {{selectOptions sr5lists.environModLight selected=document.flags.sr5.environModLight localize=true}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.EnvironmentalModGlare'}}</label>
        <select name="flags.sr5.environModGlare">
            {{selectOptions sr5lists.environModGlare selected=document.flags.sr5.environModGlare localize=true}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.EnvironmentalModWind'}}</label>
        <select name="flags.sr5.environModWind">
            {{selectOptions sr5lists.environModWind selected=document.flags.sr5.environModWind localize=true}}
        </select>
    </div>
    <div class="form-group">
        <p class="notes">{{localize 'SR5.RADIATION_SceneHint'}}</p>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.RADIATION_Level'}}</label>
        <div class="form-fields">
            <select name="flags.sr5.environRadiation">
                {{selectOptions sr5lists.radiationLevels selected=document.flags.sr5.environRadiation localize=true}}
            </select>
            <button type="button" class="sr5-radiation-expose"><i class="fa-solid fa-radiation"></i> {{localize 'SR5.RADIATION_Expose'}}</button>
        </div>
    </div>
</div>

<!-- SR5 Matrix Noise -->
<div class="tab" data-group="sheet" data-tab="matrixNoise">
    <div class="form-group">
        <p class="notes">{{localize 'SR5.SceneMatrixNoiseMsg'}}</p>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.SceneSpamZone'}}</label>
        <select name="flags.sr5.matrixSpam">
            {{selectOptions sr5lists.matrixSpam selected=document.flags.sr5.matrixSpam localize=true}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.SceneStaticZone'}}</label>
        <select name="flags.sr5.matrixStatic">
            {{selectOptions sr5lists.matrixStatic selected=document.flags.sr5.matrixStatic localize=true}}
        </select>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.SceneNoiseRating'}}</label>
        <div class="form-fields">
            <input type="number" min="0" max="36" step="1" name="flags.sr5.matrixNoise" placeholder="0" value="{{document.flags.sr5.matrixNoise}}"/>
        </div>
        <p class="hint">{{localize 'SR5.SceneNoiseRatingHint'}}</p>
    </div>
</div>

<!-- SR5 Background Count -->
<div class="tab" data-group="sheet" data-tab="backgroundCount">
    <div class="form-group">
        <p class="notes">{{localize 'SR5.SceneBackgroundCountMsg'}}</p>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.BGPhenomenon'}}</label>
        <div class="form-fields">
            <select name="flags.sr5.backgroundCountPhenomenon">
                <option value="">{{localize 'SR5.None'}}</option>
                {{selectOptions sr5phenomena selected=document.flags.sr5.backgroundCountPhenomenon localize=true}}
            </select>
        </div>
        <p class="hint">{{localize 'SR5.BGPhenomenonHint'}}</p>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.SceneBackgroundCountRating'}}</label>
        <div class="form-fields">
            <input type="number" min="-24" max="24" step="1" name="flags.sr5.backgroundCountValue" placeholder="0" value="{{document.flags.sr5.backgroundCountValue}}"/>
        </div>
        <p class="hint">{{localize 'SR5.SceneBackgroundCountRatingHint'}}</p>
    </div>
    <div class="form-group">
        <label>{{localize 'SR5.SceneBackgroundCountAlignement'}}</label>
        <div class="form-fields">
            <select name="flags.sr5.backgroundCountAlignement">
                <option value="">{{localize 'SR5.None'}}</option>
                {{selectOptions sr5lists.traditionTypes selected=document.flags.sr5.backgroundCountAlignement localize=true}}
            </select>
        </div>
    </div>
    {{#if sr5manaShifts.length}}
    <div class="form-group stacked">
        <label>{{localize 'SR5.ManaShiftRunning'}}</label>
        {{#each sr5manaShifts}}
        <div class="form-fields">
            <span>{{this.name}} ({{this.shift}}, {{this.hours}} h)</span>
            <button type="button" class="sr5-mana-shift-remove" data-id="{{this.id}}" data-tooltip="{{localize 'SR5.ManaShiftRemove'}}"><i class="fas fa-trash"></i></button>
        </div>
        {{/each}}
        <p class="hint">{{localize 'SR5.ManaShiftHint'}}</p>
    </div>
    {{/if}}
</div>
</div>
