<div class="sr-negotiation-repair-body">
  <p class="hint">{{localize 'SR5.NEGO_REPAIR_Intro'}}</p>
  {{#if last}}<p class="hint">{{last}}</p>{{/if}}
  {{#if searching}}
  <p><i class="fas fa-spinner fa-spin"></i> <span class="sr-negotiation-repair-progress">{{#if progress}}{{progress}}{{else}}{{localize 'SR5.NEGO_REPAIR_SearchingStart'}}{{/if}}</span></p>
  {{else if candidates.length}}
  <label class="checkbox sr-negotiation-repair-all">
    <input type="checkbox" name="repairAll">
    <strong>{{localize 'SR5.NEGO_REPAIR_All'}}</strong>
  </label>
  <ul class="sr-negotiation-repair-list">
    {{#each candidates}}
    <li>
      <label class="checkbox">
        <input type="checkbox" name="candidate" value="{{uuid}}">
        <strong>{{name}}</strong>{{#if owner}} <span class="hint">({{owner}})</span>{{/if}}
        — {{localize 'SR5.NEGO_REPAIR_Value'}} 0 → {{value}}{{#if from}} <span class="hint">({{from}})</span>{{/if}}
      </label>
    </li>
    {{/each}}
  </ul>
  {{#if isActiveGM}}
  <button type="button" data-action="apply"><i class="fas fa-check"></i> {{localize 'SR5.NEGO_REPAIR_Apply'}}</button>
  {{else}}
  <p class="hint">{{localize 'SR5.NEGO_REPAIR_OnlyActiveGM'}}</p>
  {{/if}}
  {{else}}
  <p>{{localize 'SR5.NEGO_REPAIR_None'}}</p>
  {{/if}}
</div>
