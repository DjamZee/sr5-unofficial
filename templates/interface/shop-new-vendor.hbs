<div class="sr-shop-new-vendor">
  <div class="form-group">
    <label>{{localize 'SR5.ShopVendorTemplate'}}</label>
    <select name="template">
      {{#each families}}
      <optgroup label="{{this.label}}">
        {{#each this.templates}}<option value="{{this.key}}">{{this.label}}</option>{{/each}}
      </optgroup>
      {{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize 'SR5.Name'}}</label>
    <input type="text" name="name" placeholder="{{localize 'SR5.ShopVendorNameHint'}}">
  </div>
  <div class="form-group">
    <label>{{localize 'SR5.ShopVendorLinked'}}</label>
    <input type="checkbox" name="linked" checked>
    <p class="hint">{{localize 'SR5.ShopVendorLinkedHint'}}</p>
  </div>
  <h4>{{localize 'SR5.ShopVendorBanner'}}</h4>
  <div class="sr-shop-banner-choices" data-banners></div>
  <p class="hint">{{localize 'SR5.ShopVendorTemplateHint'}}</p>
</div>
