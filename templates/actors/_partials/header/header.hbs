<div class="SR-Header">
	<div><img class="SRImgPortrait" src="{{actor.img}}" data-edit="img" data-action="editImage" data-tooltip="{{localize 'SR5.UI_ChangePicture'}}" /></div>
	<input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'SR5.Name'}}" />
	<nav class="sr-icon-nav tabs">
		{{#each layout.panels}}
			{{#unless @first}}
				<div class="sr-nav-separator"></div>
			{{/unless}}
			{{#each this.tabs}}
				<a data-action="tab" data-group="{{this.group}}" data-tab="{{this.id}}" class="{{this.cssClass}}">
					{{> (lookup this "icon") }}
				</a>
			{{/each}}
		{{/each}}
	</nav>
	{{#if (eq actor.type "actorSpirit")}}
		{{> systems/sr5/templates/actors/_partials/header/controls/actorSpirit.hbs}}
	{{/if}}
	{{#if (eq actor.type "actorSprite")}}
		{{> systems/sr5/templates/actors/_partials/header/controls/actorSprite.hbs}}
	{{/if}}
	{{#if (eq actor.type "actorAgent")}}
		{{> systems/sr5/templates/actors/_partials/header/controls/actorAgent.hbs}}
	{{/if}}
	{{#if (eq actor.type "actorDevice")}}
		{{> systems/sr5/templates/actors/_partials/header/controls/actorDevice.hbs}}
	{{/if}}
	{{#if (eq actor.type "actorDrone")}}
		{{> systems/sr5/templates/actors/_partials/header/controls/actorDrone.hbs}}
	{{/if}}
</div>
