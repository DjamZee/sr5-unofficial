{{#if system.conditionMonitors.core}}
<!-- CORE CONDITION MONITOR of a Monad of the original strain (Dark Terrors p. 88) -->
<div class="SRBlockSheet">
	<ul>
		<li class="grid SR-LigneEnTete SR-TextUppercase">
			<div class="col-10">{{localize 'SR5.CoreMonitor'}}</div>
			<div class="col-2 changeValueByClick" data-binding="system.conditionMonitors.core.actual.base"
			  data-helpTitle="{{localize 'SR5.CoreMonitor'}}" data-helpMessage="{{localize 'SR5.HELP_MonadCoreMonitor'}}">
				<div class="grid">
					<div class="col-6 SR-TextRight">
						{{system.conditionMonitors.core.actual.value}}/
					</div>
					<div class="col-2">
						{{system.conditionMonitors.core.value}}
					</div>
				</div>
			</div>
		</li>
	</ul>
</div>
{{/if}}
{{#each actor.cyberdecks as |item i|}}
{{#if system.isActive}}
<!-- MATRIX CONDITION MONITOR -->
	{{#if (or (eq system.type 'commlink') (eq system.type 'cyberdeck') (eq system.type 'riggerCommandConsole') (and (eq system.type 'headcase') (eq system.strain 'darkTerrors')))}}
	<div class="SRBlockSheet">
  		<ul>
			<li class="item grid SR-LigneEnTete SR-TextUppercase" data-item-id="{{_id}}">
				<div class="col-10">{{#if (eq system.type 'headcase')}}{{localize 'SR5.MonadSwarmMonitor'}}{{else}}{{localize 'SR5.MatrixMonitor'}}{{/if}}</div>
				<div class="col-2 changeValueByClick" data-binding="system.conditionMonitors.matrix.actual.base"
				  data-helpTitle="{{localize 'SR5.MatrixMonitor'}}" data-helpMessage="{{localize 'SR5.HELP_MonitorDeckMsg'}}">
					<div class="grid">
						<div class="col-6 SR-TextRight">
							{{system.conditionMonitors.matrix.actual.value}}/
						</div>
						<div class="col-2">
							{{system.conditionMonitors.matrix.value}}
						</div>
					</div>
				</div>
			</li>
		</ul>
	</div>
	{{/if}}
{{/if}}
{{/each}}
