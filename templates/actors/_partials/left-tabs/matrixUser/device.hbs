<!-- DEVICE NAME / RATING / MODE -->
<div class="SRBlockSheet">
	<ul>
		<li class="grid SR-LigneEnTete">
			<div class="col-10 SR-TextUppercase">{{system.matrix.deviceName}}</div>
			{{#if (and canReboot (or (eq actor.type 'actorPc') (eq actor.type 'actorGrunt') (eq actor.type 'actorDevice') (eq actor.type 'actorDrone')))}}
			<div class="col-2 SR-TextCenter" data-helpTitle="{{localize 'SR5.DeviceReboot'}}"
			  data-helpMessage="{{localize 'SR5.HELP_DeviceRebootMsg'}}">
				<a class="reset-deck" data-tooltip="{{localize 'SR5.DeviceReboot'}}"><em class="fas fa-sm fa-sync"></em></a>
			</div>
			{{/if}}
		</li>
		
		<li class="item grid">
			<div class="col-10">{{localize 'SR5.DeviceRating'}}</div>
			{{#if (eq actor.type 'actorDevice')}}
				<div class="col-2 SR-TextCenter"><input type="number" data-dtype="Number" name="system.matrix.deviceRating" value="{{system.matrix.deviceRating}}" placeholder="1"></div>
			{{else}}
				<div class="col-2 SR-TextCenter">{{system.matrix.deviceRating}}</div>
			{{/if}}
		</li>

		{{#if (eq actor.type 'actorDrone')}}
		<li class="grid">
			<div class="col-10">{{localize 'SR5.WirelessMode'}}</div>
			<div class="col-2 SR-TextCenter">
				{{#if (ne system.wirelessTurnedOn false)}}
				<a class="drone-wireless-toggle" data-tooltip="{{localize 'SR5.DisableWirelessMode'}}"><em class="fas fa-sm fa-wifi SR-SubColor"></em></a>
				{{else}}
				<a class="drone-wireless-toggle" data-tooltip="{{localize 'SR5.EnableWirelessMode'}}"><em class="fas fa-sm fa-wifi"></em></a>
				{{/if}}
			</div>
		</li>
		{{/if}}
		
		{{#if_g system.specialAttributes.resonance.augmented.value 0}}
			<li class="grid">
				<div class="col-10">{{localize 'SR5.SubmersionGrade'}}</div>
				<div class="col-2 SR-TextCenter changeValueByClick" data-binding="system.matrix.submersionGrade"
				  data-helpTitle="{{localize 'SR5.SubmersionGrade'}}"
              	  data-helpMessage="{{localize 'SR5.HELP_SubmersionGradeMsg'}}"
				>
					{{system.matrix.submersionGrade}}
				</div>
			</li>
			{{#if aegisLeft}}
			<li class="grid">
				<div class="col-12">{{aegisLeft}}</div>
			</li>
			{{/if}}
		{{/if_g}}

		{{#if (or (eq system.matrix.deviceType "slavedDevice") (eq system.matrix.deviceType "maglock"))}}
		<li class="grid">
			<div class="col-10">{{localize 'SR5.DEVICE_DirectlyConnected'}}</div>
			<div class="col-2 SR-TextCenter"
			  data-helpTitle="{{localize 'SR5.DEVICE_DirectlyConnected'}}"
			data-helpMessage="{{localize 'SR5.HELP_DirectlyConnectedMsg'}}"
			>
			</div>
		</li>
		{{/if}}

		{{#if (and (eq actor.type 'actorDevice') panMasterOptions)}}
		<li class="grid"
		  data-helpTitle="{{localize 'SR5.DEVICE_PanMaster'}}"
		  data-helpMessage="{{localize 'SR5.HELP_PanMasterMsg'}}"
		>
			<div class="col-5">{{localize 'SR5.DEVICE_PanMaster'}}</div>
			<div class="col-7">
				<select name="system.matrix.panMaster" data-dtype="String">
					<option value="">{{localize 'SR5.DEVICE_PanMasterNone'}}</option>
					{{#if panMasterOptions.unknown}}
					<option value="{{panMasterOptions.unknown.value}}" selected>{{panMasterOptions.unknown.label}}</option>
					{{/if}}
					{{#if panMasterOptions.hosts.length}}
					<optgroup label="{{localize 'SR5.DEVICE_PanMasterHosts'}}">
						{{selectOptions panMasterOptions.hosts selected=system.matrix.panMaster valueAttr="value" labelAttr="label"}}
					</optgroup>
					{{/if}}
					{{#if panMasterOptions.devices.length}}
					<optgroup label="{{localize 'SR5.DEVICE_PanMasterDevices'}}">
						{{selectOptions panMasterOptions.devices selected=system.matrix.panMaster valueAttr="value" labelAttr="label"}}
					</optgroup>
					{{/if}}
				</select>
			</div>
		</li>
		<li class="grid"
		  data-helpTitle="{{localize 'SR5.DEVICE_ShowAllMasters'}}"
		  data-helpMessage="{{localize 'SR5.HELP_ShowAllMastersMsg'}}"
		>
			<div class="col-10">{{localize 'SR5.DEVICE_ShowAllMasters'}}</div>
			<div class="col-2 SR-TextCenter"><input type="checkbox" data-sr5-show-all-masters {{checked panMasterOptions.showAll}}></div>
		</li>
		{{/if}}

		{{#ife system.matrix.deviceType "ice"}}
		<li class="grid" 
		  data-helpTitle="{{localize 'SR5.IceType'}}"
          data-helpMessage="{{localize 'SR5.HELP_IceTypeMsg'}}"
		>
			<select name="system.matrix.deviceSubType" data-dtype="String" required>
				<option class="SR-LightGreyColor" value="">{{localize 'SR5.ChooseOne'}}</option>
				{{selectOptions lists.iceTypes selected=system.matrix.deviceSubType localize=true}}
			</select>
		</li>
		{{#if iceHostOptions}}
		<li class="grid"
		  data-helpTitle="{{localize 'SR5.DEVICE_IceHost'}}"
		  data-helpMessage="{{localize 'SR5.HELP_IceHostMsg'}}"
		>
			<div class="col-5">{{localize 'SR5.DEVICE_IceHost'}}</div>
			<div class="col-7">
				<select name="system.matrix.hostUuid" data-dtype="String" {{#unless system.isGM}}disabled{{/unless}}>
					<option value="">{{localize 'SR5.DEVICE_IceHostNone'}}</option>
					{{#if iceHostOptions.unknown}}
					<option value="{{iceHostOptions.unknown.value}}" selected>{{iceHostOptions.unknown.label}}</option>
					{{/if}}
					{{selectOptions iceHostOptions.hosts selected=system.matrix.hostUuid valueAttr="value" labelAttr="label"}}
				</select>
			</div>
		</li>
		{{#if system.isGM}}
		<li class="grid"
		  data-helpTitle="{{localize 'SR5.DEVICE_ShowAllMasters'}}"
		  data-helpMessage="{{localize 'SR5.HELP_ShowAllMastersMsg'}}"
		>
			<div class="col-10">{{localize 'SR5.DEVICE_ShowAllMasters'}}</div>
			<div class="col-2 SR-TextCenter"><input type="checkbox" data-sr5-show-all-masters {{checked iceHostOptions.showAll}}></div>
		</li>
		{{/if}}
		{{/if}}
		{{/ife}}

		{{#if (and (eq actor.type 'actorDevice') (eq system.matrix.deviceType "host"))}}
		<li class="grid"
		  data-helpTitle="{{localize 'SR5.HostType'}}"
		  data-helpMessage="{{localize 'SR5.HELP_HostTypeMsg'}}"
		>
			<div class="col-5">{{localize 'SR5.HostType'}}</div>
			<div class="col-7">
				<select name="system.matrix.hostType" data-dtype="String">
					<option value="">{{localize 'SR5.HostTypeNone'}}</option>
					{{selectOptions lists.hostTypes selected=system.matrix.hostType localize=true}}
				</select>
			</div>
		</li>
		{{/if}}
	</ul>
</div>