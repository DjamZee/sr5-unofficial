<!-- MOVEMENT -->
<div class="SRBlockSheet">
	<ul>
	  	<li class="grid SR-LigneEnTete">
			<div class="col-7"><p class=" SR-TextUppercase">{{localize 'SR5.Movement'}}</p></div>
			<div class="col-3"><p class="SR-TextCenterOverflow">{{localize 'SR5.Values'}}</p></div>
			<div class="col-2"><p class="SR-TextCenter">{{localize 'SR5.DicePoolShort'}}</p></div>
	  	</li>
		{{#if (or (eq actor.type 'actorSpirit') system.skills.flight.rating.value)}}
		{{#each system.movements}}
		{{#if (ne @key 'hotDrop')}}

		  		<li class="grid">
					<div class="col-7"><p>{{findTranslation 'movements' @key}}</p></div>
					<div class="col-3">
						<p class="SR-TextCenterOverflow">
						{{#if (or test.dicePool movement.value)}}
				  			{{#if (eq @key 'walk')}}
								{{movement.value}} {{localize 'SR5.MeterUnit'}}
				  			{{else}}
								{{#if (and (and (ne @key 'verticalJump') (ne @key 'horizontalJumpRunning')) (ne @key 'horizontalJumpStanding'))}}
					  				{{movement.value}} (+{{extraMovement.value}})
					  					{{#ife @key 'holdBreath'}}
											{{localize 'SR5.SecondUnit'}}
					  					{{else ife @key 'treadWater'}}
											{{localize 'SR5.MinuteUnit'}}
					  					{{else}}
											{{localize 'SR5.MeterUnit'}}
					  					{{/ife}}
								{{else}}
					  				+{{extraMovement.value}} {{localize 'SR5.MeterUnit'}}
								{{/if}}
				  			{{/if}}
						{{else}}
				  			-
						{{/if}}
						</p>
					</div>
					<div class="col-2">
			  			{{#if (and test.dicePool (ne @key 'walk'))}}
							<p class="SR-TextCenter roll-logo sr-roll" data-rolltype= "movement" data-rollkey="{{@key}}"
							data-helpTitle="{{localize 'SR5.HELP_Movements' key=(findTranslation 'movements' @key)}}" 
							data-helpMessage="{{localize 'SR5.HELP_MovementsMsg'}}" 
							data-helpDetails="system.movements.{{@key}}.test"
							>
							{{test.dicePool}}</p>
			  			{{else}}
							<p class="SR-TextCenter">-</p>
			  			{{/if}}
					</div>
		  		</li>

		{{/if}}
	  	{{/each}}
		{{else}}
	  	{{#each system.movements}}
		  {{#if (and (ne @key 'fly') (ne @key 'hotDrop'))}}
		  		<li class="grid">
					<div class="col-7"><p>{{findTranslation 'movements' @key}}</p></div>
					<div class="col-3">
						<p class="SR-TextCenterOverflow">
						{{#if (or test.dicePool movement.value)}}
				  			{{#if (eq @key 'walk')}}
								{{movement.value}} {{localize 'SR5.MeterUnit'}}
				  			{{else}}
								{{#if (and (and (ne @key 'verticalJump') (ne @key 'horizontalJumpRunning')) (ne @key 'horizontalJumpStanding'))}}
					  				{{movement.value}} (+{{extraMovement.value}})
					  					{{#ife @key 'holdBreath'}}
											{{localize 'SR5.SecondUnit'}}
					  					{{else ife @key 'treadWater'}}
											{{localize 'SR5.MinuteUnit'}}
					  					{{else}}
											{{localize 'SR5.MeterUnit'}}
					  					{{/ife}}
								{{else}}
					  				+{{extraMovement.value}} {{localize 'SR5.MeterUnit'}}
								{{/if}}
				  			{{/if}}
						{{else}}
				  			-
						{{/if}}
						</p>
					</div>
					<div class="col-2">
			  			{{#if (and test.dicePool (ne @key 'walk'))}}
							<p class="SR-TextCenter roll-logo sr-roll" data-rolltype= "movement" data-rollkey="{{@key}}"
							data-helpTitle="{{localize 'SR5.HELP_Movements' key=(findTranslation 'movements' @key)}}" 
							data-helpMessage="{{localize 'SR5.HELP_MovementsMsg'}}" 
							data-helpDetails="system.movements.{{@key}}.test"
							>
							{{test.dicePool}}</p>
			  			{{else}}
							<p class="SR-TextCenter">-</p>
			  			{{/if}}
					</div>
		  		</li>
		{{/if}}
	  	{{/each}}
		{{/if}}
		{{#with system.movements.hotDrop}}
		{{#if movement.value}}
		<!-- Vulcan Systems « Hot-Drop » jetpack, Street Lethal p. 57-59 -->
		<li class="grid">
			<div class="col-7"><p>{{localize 'SR5.MovementHotDrop'}}</p></div>
			<div class="col-3"><p class="SR-TextCenterOverflow" title="{{localize 'SR5.MovementHotDropHint'}}">{{localize 'SR5.MovementHotDropDistances'}}</p></div>
			<div class="col-2">
				<p class="SR-TextCenter roll-logo sr-roll" data-rolltype= "movement" data-rollkey="hotDrop"
				data-helpTitle="{{localize 'SR5.HELP_Movements' key=(localize 'SR5.MovementHotDrop')}}"
				data-helpMessage="{{localize 'SR5.MovementHotDropHint'}}"
				data-helpDetails="system.movements.hotDrop.test"
				>
				{{test.dicePool}}</p>
			</div>
		</li>
		{{/if}}
		{{/with}}
		{{#each @root.movementBoxes as |box|}}
		<!-- Dark Terrors p. 180: a situational effect on a movement rate counts while its box is ticked -->
		<li class="grid">
			<div class="col-12"><label><input type="checkbox" data-sr5-movement-box="{{box.keysAttr}}" {{checked box.on}}> {{#if box.when}}{{box.when}} ({{box.source}}){{else}}{{box.source}}{{/if}}</label></div>
		</li>
		{{/each}}
	</ul>
</div>