<!-- METAMAGICS -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-LigneEnTete grid">
			<div class="col-10">
				<p class=" SR-TextUppercase ">{{localize 'SR5.Metamagics'}}</p>
			</div>
			<div class="col-1">
				<p class="SR-TextCenter" data-tooltip="{{localize 'SR5.Equipped'}}"><em
						class="fas fa-sm fa-thumbtack"></em></p>
			</div>
			<div class="col-1">
				{{#if owner}}
				<p class="SR-TextRight add-item" data-helpTitle="{{localize 'SR5.HELP_ItemAdd' key=(findTranslation 'itemTypes' 'itemMetamagic')}}" 
				  data-helpMessage="{{localize 'SR5.HELP_ItemAddMsg'}}">
					<a class="item-create" data-tooltip="{{localize 'SR5.Add'}}" data-type="itemMetamagic"><em class="fas fa-plus"></em></a>
				</p>
				{{/if}}
			</div>
		</li>
		{{#each actor.metamagics}}
		<li class="item grid" data-item-id="{{_id}}" draggable="true">
			<div class="col-10 deplie" data-helpTitle="{{localize 'SR5.HELP_MoreInfos'}}" data-helpMessage="{{localize 'SR5.HELP_MoreInfosMsg'}}">
				<p>{{name}}</p>
			</div>
			<div class="col-1 SR-TextCenter" data-helpTitle="{{localize 'SR5.HELP_MetamagicActivateToggle' key=name}}"
			data-helpMessage="{{localize 'SR5.HELP_MetamagicActivateToggleMsg'}}">
				<a class="toggle-value" data-dtype="Boolean" data-item-id="{{_id}}" data-binding="system.isActive" data-tooltip="{{#if system.isActive}}{{localize 'SR5.Unequip'}}{{else}}{{localize 'SR5.Equip'}}{{/if}}">
					<em class="fas fa-sm fa-thumbtack {{#if system.isActive}}SR-SubColor{{/if}}"></em></a>
			</div>
			<div class="col-1 grid SR-TextRight">
				{{#if ../owner}}
				<a data-helpTitle="{{localize 'SR5.HELP_ItemManagement' key=name}}" data-helpMessage="{{localize 'SR5.HELP_ItemManagementMsg'}}">
					<em class="fas fa-sm fa-edit item-management"></em>
				</a>
				{{/if}}
			</div>
		</li>
		{{/each}}
		{{#if actor.bloodMagicPoints.known}}
		<!-- Blood Magic Points (Street Grimoire p. 90): granted by the GM, lost after the following Combat Turn -->
		<li class="grid">
			<div class="col-8" data-tooltip="{{localize 'SR5.BloodMagicPoints_D'}}"><p>{{localize 'SR5.BloodMagicPoints'}}</p></div>
			<div class="col-2 SR-TextCenter">
				{{#if owner}}
				{{#if actor.bloodMagicPoints.hasAthame}}<a data-sr5-blood="store" data-tooltip="{{localize 'SR5.AthameStore'}}"><em class="fas fa-sm fa-khanda"></em></a>{{/if}}
				{{#if actor.bloodMagicPoints.cannibalize}}<a data-sr5-blood="cannibalize" data-tooltip="{{localize 'SR5.MetamagicCannibalize'}}"><em class="fas fa-sm fa-tint"></em></a>{{/if}}
				{{/if}}
			</div>
			<div class="col-2 SR-TextCenter"><p>{{actor.bloodMagicPoints.value}}</p></div>
		</li>
		{{#if actor.bloodMagicPoints.hasAthame}}
		<!-- Athame (Street Grimoire p. 90): the points stored, halved after 1 week, 1 month and 3 months -->
		<li class="grid">
			<div class="col-10" data-tooltip="{{localize 'SR5.AthamePoints_D'}}"><p>{{localize 'SR5.AthamePoints'}}</p></div>
			<div class="col-2 SR-TextCenter"><p>{{actor.bloodMagicPoints.athame}}</p></div>
		</li>
		{{/if}}
		{{/if}}
	</ul>
</div>