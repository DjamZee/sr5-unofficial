<!-- VEHICLES/DRONES -->
<div class="SRBlockSheet">
	<ul>
	  	<li class="SR-LigneEnTete grid">
			<div class="col-10 SR-TextUppercase">{{localize 'SR5.Vehicles'}} & {{localize 'SR5.Drones'}}</div>
			<div class="col-1"></div>
			<div class="col-1">
		  		{{#if owner}}
		  			<p class="SR-TextRight add-item" data-helpTitle="{{localize 'SR5.HELP_ItemAdd' key=(findTranslation 'itemTypes' 'itemVehicle')}}" 
					  data-helpMessage="{{localize 'SR5.HELP_ItemAddMsg'}}">
						  <a class="item-create" data-tooltip="{{localize 'SR5.Add'}}" data-type="itemVehicle"><em class="fas fa-plus"></em></a>
						</p>
		  		{{/if}}
			</div>
	  	</li>
	  	{{#each actor.vehicles as |item i|}}
	  	<li class="item {{#if storedInName}}sr-stored{{/if}}" data-item-id="{{item._id}}" draggable="true">
			<div class="grid">
		  		<div class="col-10 deplie">{{item.name}}{{#if storedInName}} <span class="sr-stored-note">({{localize 'SR5.StoredIn' storage=storedInName}})</span>{{/if}}</div>
				<!-- Relecture djamz.13, R1 (img 09-10): the icons in the columns of the other lists, in one order: wireless and
				     silent in the shared column (its first third, the "equipped" one, stays empty), then deployment and edit -->
				<div class="col-1">
				<div class="grid">
				<div class="col-6"></div>
				{{#if (gte system.conditionMonitors.matrix.actual.value system.conditionMonitors.matrix.value)}}
				<div class="col-6 SR-TextCenter"
				  data-helpTitle="{{localize 'SR5.HELP_BrickedItem' key=name}}"
				  data-helpMessage="{{localize 'SR5.HELP_BrickedItemMsg'}}"
				>
					<span><em class="fas fa-sm fa-exclamation-triangle SR-popColor"></em></span><span class="sr-silent-slot"></span>
				</div>
				{{else if item.deployedWireless}}
				<!-- The icon in a span, as the links of the other rows: alone, it left the grid cell 1 px high, at the top of
				     the row (relecture djamz.13, passe 2) -->
				<div class="col-6 SR-TextCenter" data-tooltip="{{localize 'SR5.WirelessHeldByDeployedDrone'}}">
					<span><em class="fas fa-sm fa-wifi {{#if item.deployedWireless.on}}SR-GreyColor{{else}}SR-LightGreyColor{{/if}}"></em></span><span class="sr-silent-slot"></span>
				</div>
				{{else}}
				<div class="col-6 SR-TextCenter"
				  data-helpTitle="{{localize 'SR5.HELP_WifiToggle' key=name}}"
				  data-helpMessage="{{localize 'SR5.HELP_WifiToggleMsg'}}"
				>
					{{#if system.wirelessTurnedOn}}
					<a class="toggle-value" data-dtype="Boolean" data-item-id="{{_id}}" data-binding="system.wirelessTurnedOn" data-tooltip="{{localize 'SR5.DisableWirelessMode'}}"><em class="fas fa-sm fa-wifi SR-SubColor"></em></a>
					{{else}}
					<a class="toggle-value" data-dtype="Boolean" data-item-id="{{_id}}" data-binding="system.wirelessTurnedOn" data-tooltip="{{localize 'SR5.EnableWirelessMode'}}"><em class="fas fa-sm fa-wifi"></em></a>
					{{/if}}
					{{~> systems/sr5/templates/actors/_partials/right-tabs/_common/device-silent.hbs deviceMode=(lookup @root.deviceModes _id) itemId=_id}}
				</div>
				{{/if}}
				</div>
				</div>
				<div class="col-1 sr-row-tail">
					<span class="sr-row-tail-slot">
					{{#if system.isCreated}}
					<a class="sidekickDestroy" data-dtype="Boolean" data-item-id="{{_id}}" data-binding="system.isCreated"
					  data-helpTitle="{{localize 'SR5.HELP_DroneDismiss'key=name}}"
					  data-helpMessage="{{localize 'SR5.HELP_DroneDismissMsg'}}">
						<em class="fas fa-flip-both fa-external-link-alt"></em>
					</a>
					{{else}}
					<a class="sidekickCreate" data-dtype="Boolean" data-item-id="{{_id}}" data-binding="system.isCreated"
					  data-helpTitle="{{localize 'SR5.HELP_DroneCreate'key=name}}"
					  data-helpMessage="{{localize 'SR5.HELP_DroneCreateMsg'}}">
						<em class="fas fa-external-link-alt"></em>
					</a>
					{{/if}}
					</span>
					<span class="sr-row-tail-slot">
					{{#if ../owner}}
					{{#if system.isCreated}}
					{{else}}
					<a data-helpTitle="{{localize 'SR5.HELP_ItemManagement' key=name}}" data-helpMessage="{{localize 'SR5.HELP_ItemManagementMsg'}}">
						<em class="fas fa-sm fa-edit item-management"></em>
					</a>
					{{/if}}
					{{/if}}
					</span>
				</div>
			</div>
	  	</li>
	  	{{/each}}
	</ul>
</div>